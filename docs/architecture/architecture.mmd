flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces (HTTP API)"]
        direction TB
        Client([Client or CLI]):::edge
        API["HTTP API<br/>ask, ingest, jobs"]:::edge
        Auth["KeyStore<br/>hashed API keys"]:::control
        Limit["Rate limiter<br/>per tenant"]:::control
        Client --> API --> Auth --> Limit
    end

    subgraph Jobs["Durable jobs"]
        direction TB
        Worker["JobWorker<br/>lease, heartbeat"]:::core
        Orch["Orchestrator<br/>planner, worker, critic"]:::core
        Worker --> Orch
    end

    subgraph Runtime["Agent runtime"]
        direction TB
        Agent["AgentRuntime.ask<br/>ReAct loop"]:::core
        Tools["Tenant tools<br/>search, calculator"]:::core
        Gateway["llm-gateway<br/>screen, redact, cache"]:::control
        Policy[["Policy provider<br/>offline model"]]:::edge
        Structured["Constrained JSON<br/>schema automaton"]:::control
        Agent --> Gateway --> Policy ~~~ Tools ~~~ Structured
    end

    subgraph State["State (SQLite, WAL)"]
        direction TB
        Knowledge[("Documents + index<br/>BM25, TF-IDF, HNSW")]:::data
        Ledger[("Jobs and leases<br/>step ledger")]:::data
        Spans[("Spans and keys<br/>per tenant")]:::data
        Knowledge ~~~ Ledger ~~~ Spans
    end

    subgraph Obs["Observability"]
        direction TB
        Tracer["Tracer<br/>request to tool spans"]:::obs
        Metrics["Prometheus<br/>/metrics"]:::obs
        Eval["Eval suite<br/>via public API"]:::obs
        Tracer ~~~ Metrics ~~~ Eval
    end

    Interfaces -->|ask| Runtime
    Interfaces -->|submit job| State
    Jobs -->|research steps| Runtime
    Jobs -.->|claim, checkpoint| State
    Runtime -.->|search, spans| State
    Runtime -.->|spans, counters| Obs
